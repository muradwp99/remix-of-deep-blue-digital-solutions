{"docs":[{"id":1,"question":"How quickly can we start?","answer":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Typically within 1–2 weeks. We'll scope discovery and align on a start date on our first call.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"category":"process","order":1,"updatedAt":"2026-07-08T21:01:25.422Z","createdAt":"2026-07-08T21:01:25.422Z"},{"id":2,"question":"Do you work with startups or enterprise?","answer":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Both. We tailor process and team composition — the craft standard doesn't change.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"category":"general","order":2,"updatedAt":"2026-07-08T21:01:25.426Z","createdAt":"2026-07-08T21:01:25.425Z"},{"id":3,"question":"What's your pricing model?","answer":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Fixed-scope projects, monthly retainers, and dedicated pods. We recommend the fit after discovery.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"category":"pricing","order":3,"updatedAt":"2026-07-08T21:01:25.431Z","createdAt":"2026-07-08T21:01:25.431Z"},{"id":4,"question":"Who owns the code and IP?","answer":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"You do. Full transfer on delivery, with clean docs and repository handover.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"category":"legal","order":4,"updatedAt":"2026-07-08T21:01:25.433Z","createdAt":"2026-07-08T21:01:25.433Z"},{"id":5,"question":"Do you offer post-launch support?","answer":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Yes — 84% of our clients continue on a Care plan for maintenance, iteration, and growth.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"category":"support","order":5,"updatedAt":"2026-07-08T21:01:25.436Z","createdAt":"2026-07-08T21:01:25.436Z"}],"hasNextPage":false,"hasPrevPage":false,"limit":200,"nextPage":null,"page":1,"pagingCounter":1,"prevPage":null,"totalDocs":5,"totalPages":1}